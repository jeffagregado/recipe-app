{
  "name": "recipe-app",
  "private": true,
  "scripts": {
    "neon": "neon --no-analytics",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck && pnpm run typecheck:tests",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui",
    "qa:fallow": "fallow",
    "qa:react": "pnpm --filter @recipe/web run qa:react"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "fallow": "3.32.0",
    "neon": "8.0.12",
    "turbo": "latest",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.9.1"
}
