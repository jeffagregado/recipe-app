{
	"name": "@recipe-app/contracts",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/types/index.js"
		},
		"./schemas": {
			"types": "./dist/schemas/index.d.ts",
			"default": "./dist/schemas/index.js"
		}
	},
	"dependencies": {
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"typescript": "5.9.3"
	}
}
