# Server-only NestJS base URL. Set the deployed API origin in production.
RECIPE_API_URL=http://localhost:3001

# Server-only secret sent to the API on every call, so the API trusts the browser address this server forwards. The same
# value as the API's RECIPE_WEB_PROXY_SECRET. Leave empty locally; never give it a NEXT_PUBLIC_ name.
RECIPE_WEB_PROXY_SECRET=

# Host that recipe photos are optimized from: a bare hostname, without a scheme, port or path.
# Leave empty for the storage of the Neon dev branch. A worktree gets its own branch's host in .env.local.
RECIPE_STORAGE_HOST=

# The owner's address on the privacy and terms pages. Unset shows a placeholder that reaches nobody.
CONTACT_EMAIL=

# Google Analytics 4 measurement ID, such as G-XXXXXXXXXX. Public: Next.js inlines it into the browser bundle at build
# time. Set it on the production host only; unset, no Google script loads and no analytics cookie is set.
NEXT_PUBLIC_GA_ID=
