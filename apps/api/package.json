{
  "name": "@recipe/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:auth-schema": "pnpm dlx auth@1.7.7 generate --config auth.cli.ts --output auth.generated.ts --yes",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:seed": "node dist/database/seed.main.js",
    "recipes:reconcile": "node dist/recipes/reconcile.main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:server": "node test/dev-server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/resilience": "0.0.2",
    "@recipe-app/contracts": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "12.1.2",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "18.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
