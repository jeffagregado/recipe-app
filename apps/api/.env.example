# Placeholders only. Copy to .env and fill in; never commit real values.

# Port the API listens on.
PORT=3001

# PostgreSQL URL of the Neon branch, with a database name and certificate verification enabled.
DATABASE_URL=postgresql://user:password@host.example/database?sslmode=require

# Object storage of the same Neon branch.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://branch-id.storage.example
AWS_REGION=
S3_BUCKET=

# Better Auth: a secret of at least 32 characters and the API's own base URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Exact http(s) origins allowed to call the API, comma separated. Required in production; empty means the local web origins.
AUTH_TRUSTED_ORIGINS=

# Hops in front of the API whose X-Forwarded-For entries are trusted: the host's proxy is one, the web app calling the API
# server-to-server is one more (Render behind Vercel: 2). The client is the address that many entries from the right of
# X-Forwarded-For. 0 or empty trusts the loopback web server only, for local development. Never more than the real hops.
TRUST_PROXY_HOPS=0

# Shared with the web server, which sends it on every API call: at least 32 characters, no whitespace. When set, only a
# request carrying it is given the web server's hop; any other caller is keyed one hop nearer, on the address the host's
# proxy saw. Empty keeps every request on TRUST_PROXY_HOPS, as for local development.
# Set it only with TRUST_PROXY_HOPS of 2 or more: with 1, every direct caller would share the host proxy's address.
RECIPE_WEB_PROXY_SECRET=

# Resend API key. Leave empty to write a line to the API log for each message instead of sending it.
RESEND_API_KEY=

# Sender of every message: one address, bare or as "Name <address>". Empty means "Recapp <onboarding@resend.dev>",
# Resend's shared sender, which delivers only to the Resend account owner's address.
MAIL_FROM=

# Google sign-in: the OAuth client of the Google Cloud project. Leave both empty to run without Google; the button then
# answers that Google sign-in failed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The redirect URI registered for that client: the web origin followed by /api/auth/callback/google, never the API's own
# address. Empty means http://localhost:3000/api/auth/callback/google; required in production when Google is configured.
GOOGLE_REDIRECT_URI=

# The live demo (issue #112): true adds POST /demo/start and refuses every endpoint that needs email, a password or
# Google, and every photo upload or removal. Only the demo service sets it, with RESEND_API_KEY empty. Empty means false.
DEMO_MODE=false
