# Placeholders only. Copy to .env and fill in; never commit real values.

# Port the API listens on.
PORT=3001

# PostgreSQL URL of the Neon branch, with a database name and certificate verification enabled.
DATABASE_URL=postgresql://user:password@host.example/database?sslmode=require

# Object storage of the same Neon branch.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://branch-id.storage.example
AWS_REGION=
S3_BUCKET=

# Better Auth: a secret of at least 32 characters and the API's own base URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Exact http(s) origins allowed to call the API, comma separated. Required in production; empty means the local web origins.
AUTH_TRUSTED_ORIGINS=

# Resend API key. Leave empty to write a line to the API log for each message instead of sending it.
RESEND_API_KEY=

# Sender of every message: one address, bare or as "Name <address>". Empty means "Recipe App <onboarding@resend.dev>",
# Resend's shared sender, which delivers only to the Resend account owner's address.
MAIL_FROM=
