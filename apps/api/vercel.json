{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nestjs",
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=@recipe/api",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true
    }
  }
}
